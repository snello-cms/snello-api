####
# Snello all-in-one — JVM mutable-jar (H2 + snello-admin SPA).
#
# Full control API + local H2 + filesystem docs + admin UI.
# Point OIDC at an external SSO.
#
# Two ways to ship the admin:
#   1) CI / Docker-only (this file): multi-stage COPY from snellocms/snello-admin into
#      /deployments/admin-ui; AdminSpaStatic serves it at runtime (SPA fallback included).
#   2) Local sibling repo: dev/build-aio-image.sh → bundle-admin.sh copies dist into
#      META-INF/resources before mvn package (Quarkus classpath static).
#
# Build:
#   ./mvnw -pl snello-all-in-one-app -am package -DskipTests
#   docker build -f snello-all-in-one-app/src/main/docker/Dockerfile.jvm \
#     -t snellocms/snello-all-in-one:alpha snello-all-in-one-app
# Or:  dev/build-aio-image.sh [--skip-admin-build] [tag]
#
# Admin image: edge = latest push to snello-admin main (6.x admin). latest is only moved by a release tag and
# still points at the 3.0.x admin, which lacks the 6.x pages (select query protection, scheduled actions, ...).
# Pin a build instead with --build-arg SNELLO_ADMIN_IMAGE=snellocms/snello-admin:sha-<commit>
#
# Run (SSO required; AG-UI optional keys):
#   docker run --rm -p 8080:8080 -v snello-aio:/data \
#     -e QUARKUS_OIDC_AUTH_SERVER_URL=https://sso.example/realms/snello \
#     -e QUARKUS_OIDC_CLIENT_ID=snello-api \
#     -e SNELLO_AITYPE=ai-gemini -e GEMINI_API_KEY=... \
#     snellocms/snello-all-in-one:alpha
###
ARG SNELLO_ADMIN_IMAGE=snellocms/snello-admin:edge
FROM ${SNELLO_ADMIN_IMAGE} AS snello-admin

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24

ENV LANGUAGE='en_US:en'
ENV SNELLO_DB_KIND=h2
ENV JAVA_APP_JAR=/deployments/quarkus-app/quarkus-run.jar
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV SNELLO_ADMIN_UI_PATH=/deployments/admin-ui

# Keep the quarkus-app/ folder name: mutable-jar re-augmentation (snello-optimize.sh) resolves its
# inputs as <parent>/quarkus-app/..., so flattening into /deployments breaks the rebuild at startup.
COPY --chown=185 target/quarkus-app/ /deployments/quarkus-app/
COPY --chown=185 src/main/scripts/snello-optimize.sh /deployments/snello-optimize.sh
COPY --chown=185 src/main/scripts/snello-entrypoint.sh /deployments/snello-entrypoint.sh
COPY --from=snello-admin --chown=185 /usr/share/nginx/html/ /deployments/admin-ui/

USER root
RUN chmod +x /deployments/snello-optimize.sh /deployments/snello-entrypoint.sh \
 && mkdir -p /data/files \
 && chown -R 185:0 /data /deployments/admin-ui

USER 185
EXPOSE 8080
VOLUME ["/data"]

ENTRYPOINT [ "/deployments/snello-entrypoint.sh" ]
