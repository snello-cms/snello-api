<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.snello</groupId>
        <artifactId>snello-parent</artifactId>
        <version>6.0.6-alpha</version>
    </parent>

    <artifactId>snello-all-in-one-app</artifactId>
    <packaging>quarkus</packaging>
    <name>snello-all-in-one-app</name>
    <description>Snello all-in-one API (H2 + full control surface + snello-admin SPA via Docker COPY or dev/bundle-admin.sh; external SSO)</description>

    <properties>
        <!-- false locally when running AdminSpaStaticTest; Docker black-box remains *IT via failsafe -->
        <aio.skipUnitTests>false</aio.skipUnitTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.snello</groupId>
            <artifactId>snello-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.snello</groupId>
            <artifactId>snello-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Quarkus ITs live elsewhere; enable lightweight unit tests (e.g. AdminSpaStaticTest). -->
                    <skipTests>${aio.skipUnitTests}</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <aio.baseUrl>${aio.baseUrl}</aio.baseUrl>
                        <aio.fixture>${aio.fixture}</aio.fixture>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
