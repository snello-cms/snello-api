####
# Snello query plane — JVM mutable-jar (Keycloak-style DB re-augmentation).
#
# Build:
#   ./mvnw -pl snello-query-app -am package -DskipTests
#   docker build -f snello-query-app/src/main/docker/Dockerfile.jvm \
#     -t snellocms/snello-query:alpha snello-query-app
###
FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24

ENV LANGUAGE='en_US:en'
ENV SNELLO_DB_KIND=postgresql
ENV JAVA_APP_JAR=/deployments/quarkus-app/quarkus-run.jar
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

# Keep the quarkus-app/ folder name: mutable-jar re-augmentation (snello-optimize.sh) resolves its
# inputs as <parent>/quarkus-app/..., so flattening into /deployments breaks the rebuild at startup.
COPY --chown=185 target/quarkus-app/ /deployments/quarkus-app/
COPY --chown=185 src/main/scripts/snello-optimize.sh /deployments/snello-optimize.sh
COPY --chown=185 src/main/scripts/snello-entrypoint.sh /deployments/snello-entrypoint.sh

RUN chmod +x /deployments/snello-optimize.sh /deployments/snello-entrypoint.sh

EXPOSE 8080
USER 185

ENTRYPOINT [ "/deployments/snello-entrypoint.sh" ]
